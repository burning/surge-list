#!name=X / Twitter AdBlock & QUIC Filter
#!desc=阻断 X (Twitter) QUIC 流量并使用最新可用的去广告脚本
#!category=Tweaks

[Rule]
# 拦截 X 相关的 UDP 443 流量，强制客户端回退到 TCP 从而触发 MITM
AND,((DOMAIN-SUFFIX,twitter.com),(DEST-PORT,443),(PROTOCOL,UDP)),REJECT
AND,((DOMAIN-SUFFIX,x.com),(DEST-PORT,443),(PROTOCOL,UDP)),REJECT
AND,((DOMAIN-SUFFIX,twimg.com),(DEST-PORT,443),(PROTOCOL,UDP)),REJECT

[Script]
# X 净化脚本（RuCu6 维护版本，支持 GraphQL 广告过滤与推文推荐流净化）
X_AdBlock = type=http-response,pattern=^https?:\/\/api\.(twitter|x)\.com\/(1\.1|2|graphql|i\/api)\/,requires-body=1,max-size=3145728,script-path=https://raw.githubusercontent.com/RuCu6/QuanX/main/Scripts/x.js

[MITM]
hostname = %APPEND% api.twitter.com, api.x.com
