name: X / Twitter PWA & Web AdBlock
description: 阻断 QUIC 流量并净化 X / Twitter 网页与 PWA 广告

rules:
  - DOMAIN-SUFFIX,twitter.com,REJECT,extended-matching
  - DOMAIN-SUFFIX,x.com,REJECT,extended-matching
  - DOMAIN-SUFFIX,twimg.com,REJECT,extended-matching

scriptings:
  - name: X_AdBlock
    match: ^https?:\/\/(api\.)?(twitter|x)\.com\/(1\.1|2|graphql|i\/api)\/
    type: response
    script_url: x_adblock.js
    body_required: true
    max_size: 5242880

mitm:
  hostnames:
    - x.com
    - twitter.com
    - api.x.com
    - api.twitter.com
