rules:
  - AND:
      - DOMAIN-SUFFIX,twitter.com
      - PORT,443
      - PROTOCOL,UDP
    MATCH: REJECT
  - AND:
      - DOMAIN-SUFFIX,x.com
      - PORT,443
      - PROTOCOL,UDP
    MATCH: REJECT

scriptings:
  - http_response:
      name: X_AdBlock
      match: ^https?:\/\/(api\.)?(twitter|x)\.com\/(1\.1|2|graphql|i\/api)\/
      script_url: x_adblock.js
      body_required: true
      max_size: 5242880

mitm:
  hostnames:
    - x.com
    - twitter.com
    - api.x.com
    - api.twitter.com
