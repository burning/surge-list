#!name=X / Twitter PWA & Web AdBlock
#!desc=针对 X / Twitter 网页版与 PWA 的广告与推广推文净化模块
#!category=Tweaks

[Rule]
# 拦截 QUIC 强制回退至 TCP
AND,((DOMAIN-SUFFIX,twitter.com),(DEST-PORT,443),(PROTOCOL,UDP)),REJECT
AND,((DOMAIN-SUFFIX,x.com),(DEST-PORT,443),(PROTOCOL,UDP)),REJECT

[Script]
# 匹配 App (api.x.com) 以及 网页端/PWA (x.com/i/api/)
X_AdBlock = type=http-response,pattern=^https?:\/\/(api\.)?(twitter|x)\.com\/(1\.1|2|graphql|i\/api)\/,requires-body=1,max-size=5242880,script-path=x_adblock.js

[MITM]
hostname = %APPEND% x.com, twitter.com, api.x.com, api.twitter.com
